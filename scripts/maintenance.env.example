# Copy to /etc/yashe/maintenance.env, replace placeholders, then chmod 0600.
MYSQL_DEFAULTS_FILE=/etc/yashe/mysql-client.cnf
DB_NAME=yashe_db
BACKUP_DIR=/var/www/yashe/sql/backups
LOG_DIR=/var/log/yashe

# Optional non-sensitive tuning
BACKUP_RETENTION_DAYS=30
NGINX_LOG_DIR=/var/log/nginx
NGINX_LOG_RETENTION_DAYS=15
APP_LOG=/var/log/yashe/api.log
APP_LOG_MAX_MB=100
API_HEALTH_URL=http://127.0.0.1:8080
DISK_USAGE_LIMIT=90
